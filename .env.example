# AI Challenge Bot — переменные окружения

# === Telegram ===
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_challenge
POSTGRES_USER=ai_challenge_user
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://ai_challenge_user:your_secure_password_here@localhost:5432/ai_challenge

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === AI Provider ===
# Поддерживаемые провайдеры: openai, openai_compatible, mock
AI_PROVIDER=mock
AI_API_KEY=your_ai_api_key_here
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1000
AI_TIMEOUT=30

# === Настройки бота ===
# Режим: polling / webhook
BOT_MODE=polling
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_PORT=8080

# === Логирование ===
LOG_LEVEL=INFO

# === Игровые настройки ===
DAILY_CHALLENGE_HOUR=9
DAILY_CHALLENGE_TZ=Asia/Almaty
MAX_REQUESTS_PER_MINUTE=30
